{
  "name": "strapi",
  "version": "0.1.0",
  "private": true,
  "description": "A Strapi application",
  "scripts": {
    "build": "npm run build:richtext && strapi build",
    "console": "strapi console",
    "deploy": "strapi deploy",
    "dev": "strapi develop",
    "develop": "strapi develop",
    "start": "strapi start",
    "migrate:private-media": "node scripts/private-media-migration.js",
    "test": "node --test tests/*.test.js && npm run test --workspace strapi-plugin-markdown-table",
    "typecheck": "tsc --noEmit && tsc --project src/admin/tsconfig.json --noEmit && npm run typecheck --workspace strapi-plugin-markdown-table",
    "strapi": "strapi",
    "upgrade": "npx @strapi/upgrade latest",
    "upgrade:dry": "npx @strapi/upgrade latest --dry",
    "build:richtext": "npm run build --workspace strapi-plugin-markdown-table",
    "predev": "npm run build:richtext",
    "predevelop": "npm run build:richtext",
    "watch:richtext": "npm run watch --workspace strapi-plugin-markdown-table",
    "demo:richtext": "npm run dev --workspace strapi-plugin-markdown-table",
    "test:richtext:e2e": "npm run test:e2e --workspace strapi-plugin-markdown-table"
  },
  "dependencies": {
    "@google-cloud/storage": "7.22.0",
    "@indothai/private-media": "file:providers/private-media",
    "@strapi-community/strapi-provider-upload-google-cloud-storage": "^5.0.5",
    "@strapi/database": "5.52.3",
    "@strapi/plugin-cloud": "5.52.3",
    "@strapi/plugin-users-permissions": "5.52.3",
    "@strapi/strapi": "5.52.3",
    "dotenv": "16.6.1",
    "pg": "8.20.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.30.3",
    "styled-components": "^6.0.0",
    "strapi-plugin-markdown-table": "file:src/plugins/markdown-table"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.0.0 <=26.x.x",
    "npm": ">=6.0.0"
  },
  "strapi": {
    "uuid": "6e86d7cd-d1fb-466e-b0c4-a8cdaa58ef90",
    "installId": "5391d80c814c6a9d1058646af3c1c4293724eb77f23517a052f767c2c02801ca"
  },
