{
  "kind": "collectionType",
  "collectionName": "openings",
  "info": {
    "singularName": "opening",
    "pluralName": "openings",
    "displayName": "opening"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "job_status": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "Open",
        "Closed",
        "Filled"
      ]
    },
    "location": {
      "type": "text",
      "required": true
    },
    "tags": {
      "type": "text"
    },
    "description": {
      "type": "richtext",
      "required": true
    },
    "candidates": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::candidate.candidate",
      "mappedBy": "opening"
    }
  }
}
