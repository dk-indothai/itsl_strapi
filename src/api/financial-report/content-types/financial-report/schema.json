{
  "kind": "collectionType",
  "collectionName": "financial_reports",
  "info": {
    "singularName": "financial-report",
    "pluralName": "financial-reports",
    "displayName": "financial_report"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "year": {
      "type": "integer",
      "required": true
    },
    "report_type": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "Quarter",
        "Full Year"
      ]
    },
    "quarter": {
      "type": "integer",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "report_type"
            },
            "Quarter"
          ]
        }
      },
      "required": true,
      "min": 1,
      "max": 4
    },
    "file": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "files"
      ]
    }
  }
}
