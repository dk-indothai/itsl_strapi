{
  "kind": "collectionType",
  "collectionName": "candidates",
  "info": {
    "singularName": "candidate",
    "pluralName": "candidates",
    "displayName": "job_candidate"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "contact_no": {
      "type": "string"
    },
    "resume": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "linkedin_url": {
      "type": "string",
      "required": true
    },
    "additional_links": {
      "type": "string"
    },
    "opening": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::opening.opening",
      "required": true,
      "inversedBy": "candidates"
    }
  }
}
